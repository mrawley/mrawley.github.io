---
import BaseLayout from '../layouts/BaseLayout.astro';

const timeline = [
  {
    year: 'Sep 2023 – Present',
    title: 'Senior Product Manager, Xbox Consumer Commerce Platform',
    body: `Microsoft. Purchase team lead across purchase, order management, payments, catalog, and the OEM device channel. Owned the GTA VI pre-order platform workstream, the regulated-payments redesign, and the commerce strategy for a $98M device-bundling platform. In-band promotion, September 2026.`,
  },
  {
    year: 'Mar 2021 – Sep 2023',
    title: 'Program Manager II, Consumer Commerce Platform',
    body: `Microsoft. Owned subscription management, OEM device bundling, and the consumer supportability program. Built the subscription and purchase eventing solution still serving downstream clients today.`,
  },
  {
    year: 'Aug 2018 – Mar 2021',
    title: 'Program Manager → Program Manager II, Commercial Commerce',
    body: `Microsoft. Owned transactional email and notification infrastructure, plus commercial signup. Cut the notification maintenance surface by 72% by migrating off Salesforce Marketing Cloud onto internal infrastructure.`,
  },
  {
    year: 'Jan 2014 – Apr 2018',
    title: 'Program Manager → Senior Program Manager, DatStat, Inc.',
    body: `Seattle health-tech startup, acquired in 2018. First program manager in the engineering department; established their agile practices and built DatStat Connect from concept through launch.`,
  },
  {
    year: 'June 2015',
    title: 'B.S. Informatics, University of Washington',
    body: `Cum Laude, 3.65 GPA.`,
  },
];

const honors = [
  {
    year: '2026',
    title: 'GTA VI global pre-orderlaunch on Xbox with Game+Subscription bundling.',
    body: ` - Owned the platform workstream for Rockstar's global pre-order launch, on the bundle capability I built. 20+ countries, no launch-blocking issues.`,
  },
  {
    year: '2025',
    title: 'Xbox-branded ROG Ally devices.',
    body: ` - Enabled product bundling on the handheld at launch, including controller navigation in the claim flow.`,
  },
  {
    year: '2022',
    title: 'Record-high supportability satisfaction.',
    body: ` - Led the consumer supportability team to a 4.54 out of 5 customer satisfaction score.`,
  },
  {
    year: '2022',
    title: 'PM 101.',
    body: ` - Built and taught a three-part PM lifecycle series for early-career PMs, presented at an organization-wide Day of Learning.`
  },
  {
    year: '2021',
    title: 'Named inventor on U.S. Patent 11,144,365.',
    body: ` - Automatic Clustering of Users for Enabling Viral Adoption of Applications Hosted by Multi-Tenant Systems.`,
  },
  {
    year: '2026',
    title: 'Five career promotions',
    body: ` - one with DatStat; four at Microsoft.`,
  },
];

// Core Skills. Counts are distinct contributors out of 56: 48 Connect peer
// reviewers, 8 public LinkedIn recommenders, and 4 managers pooled across 16
// Connect cycles. Full analysis: layoff-transition/evidence/peer-feedback-themes.md
const CONTRIBUTORS = 56;

// Quotes are complete sentences, verbatim. Nothing trimmed or reworded.
const coreSkills = [
  {
    label: 'Product ownership',
    count: 13,
    source: 'Principal Technical PM Lead',
    quote: `She has a genuine product instinct: she spots the opportunity, frames why it matters
      for customers, and drives it through the hard details to ship.`,
  },
  {
    label: 'Systems thinking',
    count: 14,
    source: 'Principal Software Engineer',
    quote: `The breadth of your understanding of our systems and architecture and ability to
      track so many different aspects of the project at once is extremely impressive.`,
  },
  {
    label: 'Data-informed decisions',
    count: 8,
    source: 'Partner Product Manager',
    quote: `Her analytical rigor, strategic mindset, and attention to detail enable teams to make
      progress on problems that can often feel overwhelming.`,
  },
];

const skillCounts = [
  { label: 'Cross-functional leadership', count: 39 },
  { label: 'Drives clarity in complexity', count: 29 },
  { label: 'Operating rigor & program leadership', count: 27 },
  { label: 'Documentation & synthesis', count: 23 },
  { label: 'Customer focus', count: 18 },
  { label: 'Positive attitude', count: 18 },
  { label: 'Navigating ambiguity', count: 16 },
  { label: 'Prioritization & tradeoffs', count: 16 },
  { label: 'Technical fluency', count: 15 },
  { label: 'Domain expertise', count: 15 },
  { label: 'Requirements definition', count: 15 },
  { label: 'Trust & dependability', count: 15 },
  { label: 'Mentoring & enablement', count: 14 },
  { label: 'Systems thinking', count: 14 },
  { label: 'Ownership, end to end', count: 13 },
  { label: 'Stakeholder communication', count: 13 },
  { label: 'AI-native practice', count: 12 },
  { label: 'Calm under pressure', count: 12 },
  { label: 'Unblocks and moves fast', count: 12 },
  { label: 'Workshop facilitation', count: 11 },
  { label: 'Attention to detail', count: 10 },
  { label: 'Learns fast in new domains', count: 10 },
  { label: 'Data-informed decisions', count: 8 },
  { label: 'Experimentation & piloting', count: 7 },
  { label: 'Product strategy & roadmap', count: 7 },
  { label: 'Asks incisive questions', count: 6 },
  { label: 'Audience-adaptive communication', count: 6 },
  { label: 'Clean handoffs', count: 5 },
  { label: 'Anticipates where it breaks', count: 4 },
  { label: 'Generates energy for neglected work', count: 4 },
  { label: 'Spots high-leverage fixes', count: 4 },
  { label: 'Leads without the title', count: 2 },
  { label: 'Builds forums where none existed', count: 1 },
];
const CHART_ROWS = 10;
const chartSkills = skillCounts.slice(0, CHART_ROWS);
const tagSkills = skillCounts.slice(CHART_ROWS);
const maxSkillCount = Math.max(...skillCounts.map((t) => t.count));
---

<BaseLayout title="About | Megan Lange">
  <h1 class="page-title">About</h1>

  <p class="domain-chain">
    Clinical research software <span class="arrow">&rarr;</span> email infrastructure
    <span class="arrow">&rarr;</span> sign-up <span class="arrow">&rarr;</span> commerce platforms
    <span class="arrow">&rarr;</span> subscriptions <span class="arrow">&rarr;</span> purchase
    <span class="arrow">&rarr;</span> gaming <span class="arrow">&rarr;</span> tokens
    <span class="arrow">&rarr;</span> regulated payments.
  </p>

  <p>
    It started at DatStat in 2014. I was an intern at a startup whose engineering team had no PM,
    so I became one, and built their web-based clinical research platform from concept through launch 
    that went on to run studies for the COPD Foundation, Seattle Children&rsquo;s Hospital, and the 
    Ontario HIV Treatment Network. Eight years at Microsoft since, where I&rsquo;ve grown a $98M
    device-bundling business, redesigned pay-in flows on the consumer platform per payment
    regulations, launched Game + Subscription bundling, and built shared AI tooling that cut about
    14 hours of recurring work a week across my team. Four promotions; one patent.
  </p>

  <h2>Core Skills</h2>

  <ul class="skill-cards">
    {
      coreSkills.map((s) => (
        <li>
          <span class="sc-head">
            <span class="sc-label">{s.label}</span>
            <span class="sc-count mono">{s.count}</span>
          </span>
          <p class="sc-quote">&ldquo;{s.quote}&rdquo;</p>
          <span class="sc-source mono">{s.source}</span>
        </li>
      ))
    }
  </ul>

  <p class="chart-title">What {CONTRIBUTORS} colleagues and managers endorse</p>
  <ul class="skill-chart">
    {
      chartSkills.map((t) => (
        <li>
          <span class="ch-label">{t.label}</span>
          <span class="ch-track">
            <span class="ch-bar" style={`width:${(t.count / maxSkillCount) * 100}%`} />
          </span>
          <span class="ch-value mono">{t.count}</span>
        </li>
      ))
    }
  </ul>

  <p class="chart-title">Additionally endorsed skills</p>
  <ul class="skill-tags">
    {
      tagSkills.map((t) => (
        <li>
          {t.label} <span class="tag-count">{t.count}</span>
        </li>
      ))
    }
  </ul>

  <p class="skills-note">
    *Counted across 56 people who put feedback in writing across formal peer feedback,
    performance reviews, and public LinkedIn recommendations.
  </p>

  <h2>Timeline</h2>
  <ol class="timeline">
    {timeline.map((t) => (
      <li>
        <div class="year mono">{t.year}</div>
        <strong class="title">{t.title}</strong>
        <p class="dim">{t.body}</p>
      </li>
    ))}
  </ol>

  <h2>Cool Stuff</h2>
  <ul class="h2list">
    {
      honors.map((h) => (
        <li>
          <span class="line">
            <strong>{h.title}</strong>
            <span class="year mono">{h.year}</span>
          </span>
          <span class="body">{h.body}</span>
        </li>
      ))
    }
  </ul>

  <h2>Interests</h2>
  <div class="interests">
    <div class="interest-card">
      <div class="ic-header">Professionally</div>
      <ul>
        <li>Gaming as an industry</li>
        <li>Hard problems in platforms, not just services</li>
        <li>AI tooling and skilling</li>
        <li>Shipping and bringing people along</li>
      </ul>
    </div>
    <div class="interest-card">
      <div class="ic-header">Personally</div>
      <ul>
        <li>Board &amp; video games &middot; TV</li>
        <li>Pottery &middot; sewing &middot; knitting &middot; painting</li>
        <li>Snowboarding &middot; camping</li>
        <li>DIY house projects, undertaken with unwarranted confidence</li>
        <li>ASL &amp; Deaf community (my son is deaf)</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  /* The run of domains, set as a progression rather than a sentence.
     Opens the page, so it carries the page-title's bottom spacing. */
  .domain-chain {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 2;
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg);
  }
  .domain-chain .arrow {
    color: var(--accent);
    margin: 0 0.15rem;
  }

  /* Closing line of the bio, set apart from it */
  .looking {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
  }


  /* How I Work: theme + supporting pull-quote */
  .section-note {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    margin-top: calc(-1 * var(--space-sm));
  }
  /* Core Skills: three quoted cards, then the ranked chart, then tags */
  ul.skill-cards {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-xl);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  ul.skill-cards li {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
  }
  .sc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: 0.3rem;
  }
  .sc-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--accent);
  }
  .sc-count {
    flex-shrink: 0;
    font-size: 0.6rem;
    color: var(--text-tertiary);
  }
  .sc-quote {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-primary);
    flex: 1;
  }
  .sc-source {
    font-size: 0.56rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .chart-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: var(--space-lg) 0 var(--space-md);
  }
  ul.skill-chart {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  ul.skill-chart li {
    display: grid;
    grid-template-columns: 13rem 1fr 2rem;
    align-items: center;
    gap: var(--space-md);
  }
  .ch-label {
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--text-secondary);
  }
  .ch-track {
    display: block;
    height: 12px;
    background: var(--bg-secondary);
    border-radius: 0 4px 4px 0;
  }
  /* Square at the baseline, 4px rounded at the data end */
  .ch-bar {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 0 4px 4px 0;
  }
  .ch-value {
    font-size: 0.85rem;
    color: var(--text-primary);
    text-align: right;
  }

  ul.skill-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  ul.skill-tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.3rem 0.55rem;
    line-height: 1;
  }
  ul.skill-tags .tag-count {
    color: var(--accent);
    margin-left: 0.15rem;
  }

  /* Footnote under the tags: sits clear of them, and stays quiet */
  .skills-note {
    color: var(--text-tertiary);
    font-size: 0.72rem;
    font-style: italic;
    line-height: 1.55;
    margin: var(--space-lg) 0 0;
  }

  @media (max-width: 640px) {
    ul.skill-cards {
      grid-template-columns: 1fr;
    }
    ul.skill-chart li {
      grid-template-columns: 1fr 2rem;
      row-gap: 0.3rem;
    }
    .ch-label {
      grid-column: 1 / -1;
    }
  }

  /* Timeline: variant G (thin rail with ring dots, year as small-caps eyebrow) */
  ol.timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  ol.timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: var(--border);
  }
  ol.timeline li {
    position: relative;
    padding: var(--space-md) 0 var(--space-md) var(--space-lg);
  }
  ol.timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 3px solid var(--accent);
  }
  ol.timeline .year {
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.2rem;
    white-space: nowrap;
  }
  ol.timeline .title {
    color: var(--text-primary);
    font-size: 1.05rem;
    display: block;
    margin-bottom: 0.15rem;
  }
  ol.timeline p {
    margin: 0;
  }

  /* Honors: variant C (two-column dl, year | title + body) */
  dl.honors {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
  }
  dl.honors dt {
    color: var(--accent);
    padding-top: 0.15rem;
    text-align: right;
    white-space: nowrap;
  }
  dl.honors dd {
    margin: 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }
  dl.honors dd:last-of-type {
    border-bottom: 0;
  }
  dl.honors strong {
    color: var(--text-primary);
  }

  /* Interests: variant C (split cards side by side with bullet lists) */
  .interests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  @media (max-width: 640px) {
    .interests {
      grid-template-columns: 1fr;
    }
  }
  .interest-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }
  .ic-header {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }
  .interest-card ul {
    padding-left: 1.1rem;
    margin: 0;
  }
  .interest-card li {
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
  }
</style>
