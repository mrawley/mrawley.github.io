    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-primary);
    margin: calc(-1 * var(--space-md)) 0 0;
  }

  /* How I Work: theme + supporting pull-quote */
  .section-note {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    margin-top: calc(-1 * var(--space-sm));
  }
  ul.traits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }
  ul.traits li {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-md);
  }
  ul.traits strong {
    display: block;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  ul.traits .quote {
    display: block;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 0.95rem;
  }

  /* Timeline: variant G (thin rail with ring dots, year as small-caps eyebrow) */
  ol.timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  ol.timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: var(--border);
  }
  ol.timeline li {
    position: relative;
    padding: var(--space-md) 0 var(--space-md) var(--space-lg);
  }
  ol.timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 3px solid var(--accent);
  }
  ol.timeline .year {
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.2rem;
    white-space: nowrap;
  }
  ol.timeline .title {
    color: var(--text-primary);
    font-size: 1.05rem;
    display: block;
    margin-bottom: 0.15rem;
  }
  ol.timeline p {
    margin: 0;
  }

  /* Honors: variant C (two-column dl, year | title + body) */
  dl.honors {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
  }
  dl.honors dt {
    color: var(--accent);
    padding-top: 0.15rem;
    text-align: right;
    white-space: nowrap;
  }
  dl.honors dd {
    margin: 0;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }
  dl.honors dd:last-of-type {
    border-bottom: 0;
  }
  dl.honors strong {
    color: var(--text-primary);
  }

  /* Interests: variant C (split cards side by side with bullet lists) */
  .interests {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  @media (max-width: 640px) {
    .interests {
      grid-template-columns: 1fr;
    }
  }
  .interest-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }
  .ic-header {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }
  .interest-card ul {
    padding-left: 1.1rem;
    margin: 0;
  }
  .interest-card li {
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
  }
</style>
